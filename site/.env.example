# PostgreSQL connection string from your Neon project (Dashboard -> Connection Details).
# Use the "pooled connection" string for DATABASE_URL.
DATABASE_URL="postgresql://user:password@ep-example-12345.region.aws.neon.tech/neondb?sslmode=require"

# Password required to log into /admin. Change this to something private.
ADMIN_PASSWORD="change-me"

# Random secret used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-too"
